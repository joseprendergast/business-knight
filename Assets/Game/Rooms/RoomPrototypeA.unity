  m_EditorClassIdentifier: Assembly-CSharp::BusinessNight.BusinessNightHotspot
  hotspotId: prototype_hotspot
  displayName: Black Stamp
  inspectLine: A seal from the Midnight Registry. It is still warm, as if someone
    approved the night itself.
  interactLine: Ari pockets the Black Stamp.
  repeatedInspectLine: There is nothing else to inspect here.
  requiredFlags: []
  setFlags:
  - m_collectedFirstItem
  collectItemId: prototype_item
  requiredItemId: 
  roomChangeSceneId: 
  transition: 1
  dialogueBeat:
    speaker: Ari
    text: A stamp that authorizes doors. Useful, worrying, and exactly my size.
    flagOnFirstPlay: m_seenOpeningBeat
    playOnce: 1
    holdSeconds: 2.2
